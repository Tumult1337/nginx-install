{{- if .RateLimited }}
limit_req_zone  $binary_remote_addr zone={{ .ReqZone }}:10m rate={{ .RateLimitRate }};
limit_conn_zone $binary_remote_addr zone={{ .ConnZone }}:10m;
{{ end -}}
{{- if .SSL }}
server {
    listen 80;
    listen [::]:80;
    server_name {{ .Host }};
    return 301 https://$host$request_uri;
}
{{ end }}
upstream {{ .UpstreamName }} {
    server {{ .Upstream }} max_fails=2 fail_timeout=5s;
    keepalive          256;
    keepalive_requests 10000;
    keepalive_time     1h;
    keepalive_timeout  60s;
}

server {
{{- if .SSL }}
{{- if .HTTP2Inline }}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{{- else }}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{{- end }}

    ssl_certificate     {{ .CertDir }}/fullchain.pem;
    ssl_certificate_key {{ .CertDir }}/privkey.pem;
{{- with .HSTSHeader }}
    add_header Strict-Transport-Security "{{ . }}" always;
{{- end }}
{{- if .IsCF }}

    # Cloudflare Origin CA has no OCSP responder; disable stapling to avoid
    # the "issuer certificate not found" warning. Only CF connects here, and
    # CF doesn't OCSP-check origin certs.
    ssl_stapling off;
    ssl_stapling_verify off;
{{- end }}
{{- else }}
    listen 80;
    listen [::]:80;
{{- end }}

    server_name {{ .Host }};
{{- if .IsCF }}

    include /etc/nginx/snippets/cf-allow.conf;
{{- else if .IsList }}

{{- range .AllowCIDRs }}
    allow {{ . }};
{{- end }}
    deny all;
{{- end }}

{{- if .RateLimited }}
    limit_conn {{ .ConnZone }} {{ .RateLimitConn }};
    limit_req  zone={{ .ReqZone }} burst={{ .RateLimitBurst }} nodelay;
{{- end }}

    location / {
        proxy_pass {{ .UpstreamProto }}://{{ .UpstreamName }};

        # Restates the http-block proxy_set_header defaults: setting any
        # proxy_set_header here drops inheritance of ALL of them, not just
        # Upgrade/Connection. Upgrade/Connection ride $connection_upgrade
        # (defined once in main.tmpl) to pass WebSocket upgrades through
        # while leaving plain requests on the keepalive pool.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
{{- if .UpstreamSSL }}

        # TLS to the backend. SNI + cert name use the public host, since the
        # upstream is often addressed by IP while the backend serves this cert.
        proxy_ssl_server_name on;
        proxy_ssl_name        {{ .Host }};
{{- if .UpstreamVerify }}
        proxy_ssl_verify              on;
        proxy_ssl_verify_depth        2;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
{{- else }}
        proxy_ssl_verify off;
{{- end }}
{{- end }}
    }
}
